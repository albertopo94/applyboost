# LLM PROVIDERS
# Order of fallback: gemini, groq, cerebras
LLM_PROVIDER_ORDER=gemini,groq,cerebras

# GOOGLE GEMINI
# Multiple keys can be provided as comma-separated values for rotation
GEMINI_API_KEYS=
GEMINI_API_KEY=
# Model: gemini-3-flash-preview (Recommended standard for March 2026)
GEMINI_MODEL=gemini-3-flash-preview

# GROQ
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# CEREBRAS
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# SUPABASE (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# STRIPE
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PRICE_ID_PREMIUM=
