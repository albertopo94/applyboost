# ============================================================
# ApplyBoost — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it's in .gitignore.
# See Stack doc §🔑 for secret management guidelines.
# ============================================================

# --- Supabase (self-hosted — Barcelona EU) ---
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- LLM Providers (round-robin order, left to right) ---
# Add/remove providers by editing this comma-separated list.
# The engine will cycle through them and skip any with 429.
LLM_PROVIDER_ORDER=groq,cerebras,gemini,openrouter

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_10_EXPORTS=
STRIPE_PRICE_MONTHLY=

# --- Resend (email) ---
RESEND_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
